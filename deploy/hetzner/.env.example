# Public hostname that points to the Hetzner server.
NUTEV_DOMAIN=nutev.example.com

# Caddy Basic Auth. Generate the hash on the server with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOOSE_A_STRONG_PASSWORD'
NUTEV_BASIC_AUTH_USER=admin
NUTEV_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH

# Build identity is immutable image metadata injected by the deployment workflow.
# Do not persist NUTEV_BUILD_COMMIT / NUTEV_BUILD_BRANCH /
# NUTEV_BUILD_TIME / NUTEV_VERSION in this server .env.
NUTEV_ENVIRONMENT=production

# OCR languages installed in the image.
NUTEV_OCR_LANG=eng+por

# Bibliographic provider identity / polite pools. Fill only what you use.
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
S2_API_KEY=

# Optional web / grey-literature providers exposed by the public search.
# Missing credentials are fail-open: the provider is reported as skipped_config;
# NutEV must never interpret an unconfigured connector as absence of literature.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=
SERPAPI_API_KEY=
